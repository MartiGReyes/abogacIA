        {
          "name": "Indicadores ciudadanos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/admin/ciudadanos/indicadores"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "function seguro(value) { if (!value || typeof value !== 'object') return; for (const [key, nested] of Object.entries(value)) { pm.expect(key).not.to.match(/^(dni|mail|nroCelular|contrasenaHash|codigoConfirmacion|token|url|sesion|sesionDidit|referencia|workflow|avisoHash|accesoRegistroHash|resultadoDiditId|domicilio|documentos)$/i); seguro(nested); } }",
                  "pm.test('DTO sin datos sensibles', () => seguro(data));",
                  "pm.test('Sin caché', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
                ]
