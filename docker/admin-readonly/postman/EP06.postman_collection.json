{
  "info": {
    "name": "EP06 — Administración aislada (solo pruebas)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Preparada, no ejecutada. Solo localhost:5180. Contraseñas vacías en el entorno; completar localmente con las elegidas para EP06. No usar credenciales reales. Sin SQL, registro ni llamadas Didit."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.environment.get('baseUrl') !== 'http://localhost:5180') { pm.execution.skipRequest(); throw new Error('Colección restringida al entorno EP06 localhost:5180.'); }",
          "if (pm.request.url.toString().includes('/api/auth/login')) { const body=JSON.parse(pm.request.body.raw); const key=body.tipoCuenta==='ADMIN'?'adminPassword':'fixturePassword'; if (!pm.environment.get(key)) { pm.execution.skipRequest(); throw new Error('Completar la contraseña de prueba en el entorno local de Postman.'); } body.contrasena=pm.environment.get(key); pm.request.body.update(JSON.stringify(body)); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Login real de las tres cuentas sintéticas",
      "item": [
        {
          "name": "Login ADMIN de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"admin.ep06@example.com\",\n  \"contrasena\": \"{{adminPassword}}\",\n  \"tipoCuenta\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login ADMIN: 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const body = pm.response.json(); pm.test('Rol correcto', () => pm.expect(body.rol).to.eql('ADMIN')); pm.environment.set('adminToken', body.token); } else { pm.environment.unset('adminToken'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CIUDADANO de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
